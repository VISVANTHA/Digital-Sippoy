{
  "name": "digital-sippoy-ds-029",
  "version": "1.0.0",
  "private": true,
  "description": "Digital-Sippoy DS-029: Next.js 15.5.24 / React 19.1.0 Pages Router, Webpack, npm. Microservices architecture note.",
  "engines": {
    "node": "20.x"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:report": "eslint . --ext .ts,.tsx -f json -o lint-report.json",
    "dup": "jscpd . --config jscpd.json",
    "test": "mocha",
    "test:coverage": "nyc npm test",
    "test:coverage:gate": "nyc --check-coverage --statements 95 --functions 95 --lines 95 --branches 85 npm test",
    "mutation": "stryker run"
  },
  "dependencies": {
    "next": "15.5.24",
    "next-auth": "^4.24.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@stryker-mutator/core": "^8.6.0",
    "@stryker-mutator/mocha-runner": "^8.6.0",
    "@types/mocha": "^10.0.9",
    "@types/node": "^20.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "eslint-plugin-security": "^3.0.1",
    "jscpd": "^4.0.5",
    "mocha": "^10.7.3",
    "node-mocks-http": "^1.16.1",
    "nyc": "^17.1.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  }
}
